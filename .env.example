# Copie para .env e ajuste os valores para o seu ambiente local.
# cp .env.example .env

ENVIRONMENT=development
LOG_LEVEL=INFO

# PostgreSQL
POSTGRES_DB=factory
POSTGRES_USER=factory
POSTGRES_PASSWORD=factory
DATABASE_URL=postgresql+asyncpg://factory:factory@postgres:5432/factory

# Redis
REDIS_URL=redis://redis:6379/0

# RabbitMQ
RABBITMQ_DEFAULT_USER=factory
RABBITMQ_DEFAULT_PASS=factory
RABBITMQ_URL=amqp://factory:factory@rabbitmq:5672/

# MinIO
MINIO_ROOT_USER=factory
MINIO_ROOT_PASSWORD=local-development-password
MINIO_ENDPOINT=minio:9000
MINIO_ACCESS_KEY=factory
MINIO_SECRET_KEY=local-development-password
MINIO_BUCKET=factory
MINIO_SECURE=false

# Ollama (executado no host, não no container)
OLLAMA_BASE_URL=http://host.docker.internal:11434
OLLAMA_PRIMARY_MODEL=qwen2.5-coder:7b
OLLAMA_FALLBACK_MODEL=llama3.1:8b

# Observabilidade
OTEL_EXPORTER_OTLP_ENDPOINT=http://otel-collector:4317
OTEL_SERVICE_NAME=factory-api

# Autenticação — troque em qualquer ambiente que não seja local
JWT_SECRET_KEY=change-me-in-local-dev
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_MINUTES=1440

# Orquestração
MAX_GATE_CYCLES=3
STAGE_TIMEOUT_SECONDS=1800
POLL_INTERVAL_SECONDS=2.0

# Grafana
GF_SECURITY_ADMIN_USER=admin
GF_SECURITY_ADMIN_PASSWORD=admin
